# Testnet only. The service refuses to start on any chain that is not on its testnet list.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# BIP-39 phrase. Holds the hot wallet key and every deposit key. Testnet funds only.
# Generate one with: node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
MNEMONIC=

# Shared key that callers (the exchange backend) send in the x-api-key header. At least 24 characters.
API_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/phantom_wallet
REDIS_URL=redis://localhost:6379
PORT=3002

# Number of blocks a deposit or withdrawal must be buried under (12 is a common testnet choice).
CONFIRMATIONS=12

# Assets and limits, in base units (wei for ETH, 6 decimals for a typical stablecoin).
# ASSETS_JSON=[{"symbol":"ETH","type":"native","decimals":18,"maxPerTx":"1000000000000000000","dailyLimit":"5000000000000000000","minSweep":"10000000000000000","hotMin":"100000000000000000"},{"symbol":"USDC","type":"erc20","address":"0x...","decimals":6,"maxPerTx":"1000000000","dailyLimit":"5000000000","minSweep":"1000000","hotMin":"100000000"}]

# Optional: deliver deposit and withdrawal events to another service. Signed with HMAC-SHA256.
# WEBHOOK_URL=http://localhost:3000/internal/wallet-events
# WEBHOOK_SECRET=at-least-16-characters

# Optional tuning (defaults shown)
# START_BLOCK=            first block to scan on the very first run; defaults to the current block
# BUMP_AFTER_SEC=120      resend a stuck withdrawal with a higher fee after this long
# BUMP_FACTOR_PCT=125     fee increase per resend (must be at least 110)
# MAX_BUMPS=5
# WITHDRAWAL_ATTEMPTS=5
# RETRY_BACKOFF_MS=15000
# WATCH_INTERVAL_MS=5000
# MONITOR_INTERVAL_MS=5000
# SWEEP_INTERVAL_MS=60000   0 turns the sweeper off
